{
  "name": "solana-wallet-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@vitest/coverage-v8": "^1.6.0",
    "prettier": "latest",
    "rpc-websockets": "^7.11.2",
    "turbo": "latest",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "rpc-websockets": "7.5.0"
    }
  },
  "dependencies": {
    "expo": "~50.0.17",
    "react": "18.2.0",
    "react-native": "0.73.6"
  }
}
