{
  "name": "solana-wallet-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "prettier": "latest",
    "rpc-websockets": "^7.11.2",
    "turbo": "latest",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "rpc-websockets": "7.5.0"
    }
  }
}
